# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sms_db?schema=public"

# JWT Authentication Secrets (Min 32 characters each)
JWT_ACCESS_SECRET="change-this-to-a-secure-random-access-secret-32-chars"
JWT_REFRESH_SECRET="change-this-to-a-secure-random-refresh-secret-32-chars"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local Storage Uploads Directory
UPLOAD_DIR="./uploads"
